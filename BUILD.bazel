load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/Syndic/unnatural_designs
gazelle(name = "gazelle")

# Workflows read as *test data*, not built: several tests assert couplings that hold across files
# and stay green while drifting, so each reads the real file rather than a fixture. Which test
# asserts what is left to the `data` edge that reaches for it — `git grep '//:\.github/workflows/'
# -- '*.bazel'` answers it — because an enumeration here is a copy of something already declared,
# and it drifts: the list this replaces had gone stale on both counts, naming a test that no longer
# reads a workflow and omitting one that does. (One coupling did leave: the two workflows'
# classification rules used to be held against each other here, and are now defined once in
# meta/scripts/path_classification_pattern_sets.py, so there is nothing left to hold.)
exports_files([
    ".github/workflows/ci.yml",
    ".github/workflows/devcontainer.yml",
    ".github/workflows/security.yml",
    # The canonical Python language level, read by //meta/scripts:test_check_python_version so
    # its sweep over the repo's real YAML compares against the same value CI does.
    ".python-version",
    # Renovate's config, read by //meta/scripts:test_renovate_grouping — one grouping rule is
    # correct only while it sits after the catch-all, and a reorder breaks it with no error.
    "renovate.json",
])

# Every workflow, as one dep: //meta/scripts:test_check_modules asserts the matrix-shape guard
# finds nothing to flag in any of them, and a glob keeps a newly added workflow in that sweep
# without a BUILD edit — which is when a new matrix is most likely to arrive.
filegroup(
    name = "workflows",
    # `.yaml` too, for the same reason :composite_actions takes it: the guards glob `*.y*ml`, so
    # a workflow spelled that way would be read in CI and absent from every sandboxed test.
    # `allow_empty` because the repo happens to use only `.yml` today — that is a fact about the
    # tree, not a constraint, and the whole point is that this list need not be curated.
    srcs = glob(
        [
            ".github/workflows/*.yaml",
            ".github/workflows/*.yml",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Composite actions, kept separate from :workflows because they are a different file shape —
# steps under `runs:` rather than under `jobs.*` — and only the guards that read steps want them.
# //meta/scripts:test_check_python_version does: a `setup-python` step pins the language level
# wherever it lives, so a guard that read only `.github/workflows/` would have a blind spot here.
filegroup(
    name = "composite_actions",
    # Must stay as wide as `action_yaml_files()` in //meta/scripts:check_python_version, which
    # takes any depth and either extension. A narrower glob here hides files from the sandboxed
    # test while CI still reads them — green locally, red on the PR, and the non-vacuity guard
    # keeps passing because some other action.yml is present.
    srcs = glob(
        [
            ".github/actions/**/action.yaml",
            ".github/actions/**/action.yml",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Same posture for prose that hand-copies something the tests can check it against: the hook table
# against the config's ids (//meta/scripts:test_precommit_docs), and both docs against the required
# check name security.yml's fan-in carries (//meta/scripts:test_codeql_toolchain).
exports_files([
    ".claude/CLAUDE.md",
    ".pre-commit-config.yaml",
    "README.md",
])

# Editor settings name extensions, and which list has to carry one depends on the settings
# scope — see //.devcontainer:test_devcontainer_config.
exports_files([
    ".vscode/extensions.json",
    ".vscode/settings.json",
])
