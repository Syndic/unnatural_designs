load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@unnatural_designs_pypi//:requirements.bzl", "requirement")

py_library(
    name = "_workspace_lib",
    srcs = ["_workspace.py"],
)

py_test(
    name = "test__workspace",
    size = "small",
    srcs = ["test__workspace.py"],
    main = "test__workspace.py",
    deps = [":_workspace_lib"],
)

# The named pattern sets every consumer classifies paths against. Plain module-level constants
# composed by set union, so there is no format to parse and no resolver to get wrong; a mistyped
# set name is an import-time NameError rather than a silently empty group.
py_library(
    name = "path_classification_pattern_sets_lib",
    srcs = ["path_classification_pattern_sets.py"],
)

py_test(
    name = "test_path_classification_pattern_sets",
    size = "small",
    srcs = ["test_path_classification_pattern_sets.py"],
    main = "test_path_classification_pattern_sets.py",
    deps = [":path_classification_pattern_sets_lib"],
)

# The one library here that needs a third-party dep. Kept separate from _workspace_lib so the
# four check scripts that never read a workflow — go_work, adr_numbers, secrets_dir, no_cgo —
# stay dependency-free, along with the CI job each of them runs in.
py_library(
    name = "_workflows_lib",
    srcs = ["_workflows.py"],
    deps = [requirement("pyyaml")],
)

py_test(
    name = "test__workflows",
    size = "small",
    srcs = ["test__workflows.py"],
    # Real workflow files: the parser has to be held against them, since a false positive
    # there fails CI for everyone and no synthetic fixture would show it.
    data = ["//:workflows"],
    main = "test__workflows.py",
    deps = [":_workflows_lib"],
)

