# No script half: the coupling is between two checked-in files, so the assertion is the whole
# gate. Rides `bazel test //...` rather than costing a CI job of its own.
py_test(
    name = "test_precommit_docs",
    size = "small",
    srcs = ["test_precommit_docs.py"],
    data = [
        "//:.pre-commit-config.yaml",
        "//:README.md",
    ],
    main = "test_precommit_docs.py",
)

# Same shape, and the same reason: the assertion is the whole gate. What it guards fails only
# once go.work outruns the runner image's Go, which is too late to learn it from CI.
py_test(
    name = "test_codeql_toolchain",
    size = "small",
    srcs = ["test_codeql_toolchain.py"],
    # The docs are here for one string: the required check name, which lives in repo settings and
    # so can only be held against the copies that quote it.
    data = [
        "//:.claude/CLAUDE.md",
        "//:.github/workflows/security.yml",
        "//:README.md",
    ],
    main = "test_codeql_toolchain.py",
)

# Same shape as the two above: the assertion is the whole gate. What it guards is invisible while
