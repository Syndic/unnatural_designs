{
  "name": "UnnaturalDesigns",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      // Override the shared base image, so a change to it is smoke-tested against this
      // consumer in the same PR (CI sets DEVCONTAINER_BASE_IMAGE to the locally loaded
      // devcontainer-base:ci). The host variable is namespaced because its value goes
      // straight into FROM unvalidated; the build arg it feeds keeps the short name, being
      // scoped to this build. The `pinned-base` default is a Dockerfile stage alias, not a
      // reference: a bare ${localEnv:...} passes an empty --build-arg when unset, and a
      // substitution default is truncated at its first `:` so it could never carry a digest.
      // See "Consuming the image" in meta/devcontainer-base/README.md.
      "BASE_IMAGE": "${localEnv:DEVCONTAINER_BASE_IMAGE:pinned-base}"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "installZsh": true,
      "configureZshAsDefaultShell": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/go:1.3.4": {
      "version": "1.26.6"
    },
    // Python is NOT a devcontainer feature: that feature compiles CPython from source
    // (~2 min/build). The Dockerfile installs a prebuilt uv-managed interpreter instead
    // (PYTHON_VERSION there, Renovate-tracked in lockstep with MODULE.bazel / setup-python).
    "ghcr.io/devcontainers/features/github-cli:1.1.1": {},
    "ghcr.io/devcontainers/features/git:1.3.8": {}
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "GOTOOLCHAIN": "local",
    // Forward host ssh-agent for signed commits — see meta/devcontainer-base/README.md.
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock"
  },
  // Make git fully resolve inside the container for ANY checkout layout — a full
  // clone, the main worktree, or a linked worktree living anywhere on disk —
  // when launched via the `devcontainer` CLI (which, unlike VS Code's Dev
  // Containers extension, does not special-case worktrees). See
  // meta/devcontainer-base/README.md for the full mechanism; initialize.sh and
  // meta/devcontainer-base/scripts/ carry the per-step commentary.
  "initializeCommand": ".devcontainer/initialize.sh",
  "mounts": [
    // A volume per cache *root* — the whole of ~/.cache, not one tool's directory inside it.
    // See ".claude/CLAUDE.md", "Devcontainer cache volumes".
    "source=ud-cache,target=/home/vscode/.cache,type=volume",
    // $GOPATH/pkg — the whole derived half of GOPATH (mod + sumdb), which the go feature puts
    // at /go. Not all of /go: `bin/` there is image content a volume would shadow. Not
    // /go/pkg/mod either: that leaves sumdb out and its root-owned parent breaks `go install`.
    "source=ud-go-pkg-cache,target=/go/pkg,type=volume",
    // Bind the symlink (a static, workspace-relative SOURCE) to the static
    // container path the shared plumbing points the host-absolute path at. Docker
    // follows the symlink host-side, so this resolves to wherever the real git
    // common dir lives without the config naming that dynamic path.
    "source=${localWorkspaceFolder}/.devcontainer/.host-git-common,target=/host-git-common,type=bind",
    // Forward host ssh-agent for signed commits — see meta/devcontainer-base/README.md.
    "source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind",
    // Same static-symlink-source trick as .host-git-common: initialize.sh points these at
    // whatever the host actually uses, so devcontainer.json never names a host path. See
    // "Signed commits under the devcontainer CLI" in meta/devcontainer-base/README.md.
    // known_hosts is deliberately writable — accepting a new host in any container writes
    // through to the host's real file, so later containers start with it. Appends only:
    // rewriting a single-file bind via temp+rename fails EBUSY in-container (so
    // `ssh-keygen -R` won't work there), and the same rewrite done on the host swaps the
    // inode out from under a running container. Neither affects accepting a new host.
    "source=${localWorkspaceFolder}/.devcontainer/.host-known-hosts,target=/home/vscode/.ssh/known_hosts,type=bind",
    // allowed_signers is read-only: nothing should ever write the trust set.
    "source=${localWorkspaceFolder}/.devcontainer/.host-allowed-signers,target=/home/vscode/.ssh/allowed_signers,type=bind,readonly"
  ],
  // Mount the workspace at its real host path (not the default /workspaces/<name>)
  // so the worktree's own files — and the .git file's back-pointer — line up
  // verbatim with the host-absolute paths git follows.
  "workspaceFolder": "${localWorkspaceFolder}",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": ".devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "astral-sh.ty",
        "bazelbuild.vscode-bazel",
        "charliermarsh.ruff",
        "cnshenj.vscode-task-manager",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "golang.go",
        "gruntfuggly.todo-tree",
        "Gruntfuggly.triggertaskonsave",
        "mechatroner.rainbow-csv",
        "ms-azuretools.vscode-containers",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-python.debugpy",
        "ms-python.python",
        "redhat.vscode-yaml",
        "ryanluker.vscode-coverage-gutters",
        "timonwong.shellcheck",
      ],
      "settings": {
        "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
        "// Ruff format-on-save": "charliermarsh.ruff surfaces diagnostics inline; this block makes it the default Python formatter so `editor.formatOnSave` calls ruff format, and runs ruff check --fix + import-organize as save-time code actions. Config is read from `[tool.ruff]` in //:pyproject.toml — single source of truth shared with CI + pre-commit. Container-scoped because `editor.defaultFormatter` is the one setting that raises when its extension is absent, and ruff is not recommended for host windows.",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "// ShellCheck binary": "Container-scoped on purpose: this path exists only in here, and .vscode/settings.json would apply it to a host window too, where the extension fails to spawn rather than falling back. The Dockerfile installs it from a pinned upstream release and ci.yml reads that same pin, so the editor and the gating job run the same version; a host window uses the extension's bundled copy instead.",
        "shellcheck.executablePath": "/usr/local/bin/shellcheck"
      }
    }
  }
}
