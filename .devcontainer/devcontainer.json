{
  "name": "UnnaturalDesigns",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "installZsh": true,
      "configureZshAsDefaultShell": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/go:1.3.4": {
      "version": "1.26.5"
    },
    // Python is NOT a devcontainer feature: that feature compiles CPython from source
    // (~2 min/build). The Dockerfile installs a prebuilt uv-managed interpreter instead
    // (PYTHON_VERSION there, Renovate-tracked in lockstep with MODULE.bazel / setup-python).
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {},
    "ghcr.io/devcontainers/features/git:1.3.8": {}
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "GOTOOLCHAIN": "local",
    // Forward host ssh-agent for signed commits — see CLAUDE.md "Signed commits under devcontainer CLI".
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock"
  },
  // Make git fully resolve inside the container for ANY checkout layout — a full
  // clone, the main worktree, or a linked worktree living anywhere on disk —
  // when launched via the `devcontainer` CLI (which, unlike VS Code's Dev
  // Containers extension, does not special-case worktrees). See ".devcontainer
  // worktree + timezone plumbing" in .claude/CLAUDE.md for the full mechanism;
  // initialize.sh and plumbing.sh carry the per-step commentary.
  "initializeCommand": ".devcontainer/initialize.sh",
  "mounts": [
    "source=ud-bazel-cache,target=/home/vscode/.cache/bazel,type=volume",
    "source=ud-go-cache,target=/home/vscode/go,type=volume",
    // Bind the symlink (a static, workspace-relative SOURCE) to the static
    // container path plumbing.sh points the host-absolute path at. Docker
    // follows the symlink host-side, so this resolves to wherever the real git
    // common dir lives without the config naming that dynamic path.
    "source=${localWorkspaceFolder}/.devcontainer/.host-git-common,target=/host-git-common,type=bind",
    // Forward host ssh-agent for signed commits — see CLAUDE.md "Signed commits under devcontainer CLI".
    "source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind",
    // Same static-symlink-source trick as .host-git-common: initialize.sh points these at
    // whatever the host actually uses, so devcontainer.json never names a host path. See
    // .claude/CLAUDE.md ".devcontainer signed commits under CLI".
    // known_hosts is deliberately writable — accepting a new host in any container writes
    // through to the host's real file, so later containers start with it.
    "source=${localWorkspaceFolder}/.devcontainer/.host-known-hosts,target=/home/vscode/.ssh/known_hosts,type=bind",
    // allowed_signers is read-only: nothing should ever write the trust set.
    "source=${localWorkspaceFolder}/.devcontainer/.host-allowed-signers,target=/home/vscode/.ssh/allowed_signers,type=bind,readonly"
  ],
  // Mount the workspace at its real host path (not the default /workspaces/<name>)
  // so the worktree's own files — and the .git file's back-pointer — line up
  // verbatim with the host-absolute paths git follows.
  "workspaceFolder": "${localWorkspaceFolder}",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": ".devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "astral-sh.ty",
        "bazelbuild.vscode-bazel",
        "charliermarsh.ruff",
        "cnshenj.vscode-task-manager",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "golang.go",
        "gruntfuggly.todo-tree",
        "Gruntfuggly.triggertaskonsave",
        "mechatroner.rainbow-csv",
        "ms-azuretools.vscode-containers",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-python.debugpy",
        "ms-python.python",
        "redhat.vscode-yaml",
        "ryanluker.vscode-coverage-gutters",
      ],
      "settings": {
        "todo-tree.ripgrep.ripgrep": "/usr/bin/rg"
      }
    }
  }
}
