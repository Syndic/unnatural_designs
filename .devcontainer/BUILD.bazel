load("@rules_python//python:defs.bzl", "py_test")

# The host stub is shell (it runs before any container exists), but its decision logic is
# unit-tested from Python so it rides the authoritative `bazel test //...` gate. The shared
# library it feeds is tested in //meta/devcontainer-base.
py_test(
    name = "test_initialize",
    size = "small",
    srcs = ["test_initialize.py"],
    data = ["initialize.sh"],
    main = "test_initialize.py",
)

# The BASE_IMAGE override spans devcontainer.json and the Dockerfile, and every wrong shape
# fails at container-build time or not at all — so the coupling is asserted from the files.
py_test(
    name = "test_devcontainer_config",
    size = "small",
    srcs = ["test_devcontainer_config.py"],
    data = [
        "Dockerfile",
        "devcontainer.json",
        "post-create.sh",
        "post-start.sh",
        "//:.github/workflows/devcontainer.yml",
    ],
    main = "test_devcontainer_config.py",
    deps = ["//meta/scripts:sync_base_image_pin_lib"],
)

# The pin is a derived file (see meta/scripts/sync_base_image_pin.py). The `base-image-pin`
# pre-commit hook keeps it fresh; this is the half that cannot be bypassed — hooks don't run for
# `--no-verify`, a web edit, or the helper app's API commits, and don't re-run on a rebase.
# Asserting it needs only the assembled image, which Bazel produces without a daemon, so it rides
# `bazel test //...` instead of costing a CI job of its own.
py_test(
    name = "test_base_image_pin",
    size = "small",
    srcs = ["test_base_image_pin.py"],
    data = [
        "Dockerfile",
        "//meta/devcontainer-base:image",
    ],
    main = "test_base_image_pin.py",
    deps = ["//meta/scripts:sync_base_image_pin_lib"],
)
