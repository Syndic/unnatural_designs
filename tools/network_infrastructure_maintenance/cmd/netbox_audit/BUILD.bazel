load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "netbox_audit_lib",
    srcs = [
        "checks.go",
        "config.go",
        "constants.go",
        "main.go",
        "models.go",
        "report.go",
    ],
    importpath = "github.com/Syndic/unnatural_designs/tools/network_infrastructure_maintenance/cmd/netbox_audit",
    visibility = ["//visibility:private"],
    deps = [
        "//tools/network_infrastructure_maintenance/internal/audit",
        "//tools/network_infrastructure_maintenance/internal/netbox",
        "//tools/network_infrastructure_maintenance/internal/shared",
        "//tools/network_infrastructure_maintenance/internal/ui/progress",
    ],
)

go_binary(
    name = "netbox_audit",
    embed = [":netbox_audit_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "netbox_audit_test",
    size = "small",
    srcs = [
        "config_docs_test.go",
        "main_test.go",
    ],
    # config_docs_test.go reads the docs as test data; they are prose that hand-copies the
    # policy schema, and a wrong copy fails nowhere else.
    data = [
        "CHECKS.md",
        "CONFIG.md",
    ],
    embed = [":netbox_audit_lib"],
    deps = [
        "//tools/network_infrastructure_maintenance/internal/audit",
        "//tools/network_infrastructure_maintenance/internal/netbox",
        "//tools/network_infrastructure_maintenance/internal/shared",
        "//tools/network_infrastructure_maintenance/internal/ui/progress",
    ],
)
